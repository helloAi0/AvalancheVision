# Copernicus Data Space Ecosystem (CDSE) Credentials
# Register for a free account at https://dataspace.copernicus.eu
CDSE_CLIENT_ID=your_cdse_client_id_here
CDSE_CLIENT_SECRET=your_cdse_client_secret_here

# Local Data Paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# Comma-separated browser origins allowed to call the API
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
USE_SQLITE=false
# Set in staging/production to protect expensive API operations
API_KEY=
# Set to redis://redis:6379/0 for queue-backed deployment; leave empty for local thread fallback
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# PostGIS / PostgreSQL Configuration
POSTGRES_USER=avalanche
POSTGRES_PASSWORD=avalanche_secure_pass
POSTGRES_DB=avalanchevision_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432